#!/usr/bin/env bash
# ==============================================================================
# BINARIO LINUX - PROTONUP-QT (GE-PROTON MANAGER) LAUNCHER
# ==============================================================================

set -e

APP_ID="net.davidotek.pupgui2"

# 1. Comprobar si existe como binario de sistema
if command -v protonup-qt &>/dev/null; then
    exec protonup-qt "$@"
fi

# 2. Comprobar si está instalado vía Flatpak
if flatpak info "${APP_ID}" &>/dev/null; then
    exec flatpak run "${APP_ID}" "$@"
fi

# 3. Si no está instalado, ofrecer instalación automática
if command -v kdialog &>/dev/null; then
    kdialog --title "ProtonUp-Qt (Gestor de GE-Proton)" \
            --yesno "ProtonUp-Qt te permite instalar y actualizar las versiones más recientes de Proton-GE (GloriousEggroll) y Wine-GE para Steam y Heroic con un solo clic.\n\n¿Deseas descargarlo e instalarlo ahora?"
    
    if [ $? -eq 0 ]; then
        konsole --hold -e bash -c "echo '[+] Agregando repositorio Flathub e instalando ProtonUp-Qt...'; flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo; flatpak install -y flathub ${APP_ID}; echo '[✓] Instalación completada. Iniciando...'; flatpak run ${APP_ID}"
    fi
else
    echo "[+] Instalando ProtonUp-Qt desde Flathub..."
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    flatpak install -y flathub "${APP_ID}"
    flatpak run "${APP_ID}" "$@"
fi
